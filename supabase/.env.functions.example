# ============================================================================
# KODA — Secrets de las Edge Functions (Supabase). NUNCA subir el archivo real.
# Copiar a supabase/.env.functions, completar y:
#   supabase secrets set --env-file supabase/.env.functions
# ============================================================================

# Inyectadas por Supabase en runtime; setealas si tu proyecto no las expone.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fuente paga (opcional). Sin esto, KODA usa solo OSM/Overpass (gratis).
GOOGLE_PLACES_API_KEY=
COSTO_MAX_MENSUAL_USD=50

# Discord (Fase 3) — webhooks por canal.
DISCORD_WEBHOOK_HOT=
DISCORD_WEBHOOK_NUEVOS=
DISCORD_WEBHOOK_REPORTES=
DISCORD_WEBHOOK_ERRORES=

# URL del panel para los enlaces de las notificaciones.
KODA_PANEL_URL=https://koda.connexoapp.com
