# ============================================================================
# KODA — Variables de entorno del FRONTEND (Vercel)
# Solo claves PÚBLICAS. Copiar a .env.local para desarrollo.
# La service_role key y las API keys de fuentes NUNCA van aquí:
# viven en los Secrets de Supabase (Edge Functions).
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=KODA

# Opcional — solo si se habilita la pantalla de mapa
VITE_MAPS_EMBED_KEY=

# Opcional — mapa base de la pantalla Mapa. Vacío = OpenStreetMap estándar (sin clave,
# oscurecido por CSS). Para un proveedor de pago (MapTiler, Stadia…) pon aquí su URL de
# teselas, p. ej. https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=TU_CLAVE
VITE_MAP_TILES_URL=
