# ============================================================================
# KODA — Secrets de las Edge Functions (Supabase). NUNCA subir el archivo real.
# Copiar a supabase/.env.functions, completar y:
#   supabase secrets set --env-file supabase/.env.functions
# ============================================================================

# Inyectadas por Supabase en runtime; setealas si tu proyecto no las expone.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MULTIUSUARIO: cada usuario guarda SU API key de Google Places y SUS webhooks de
# Discord desde el panel (Configuración → Integraciones, cifrados en Vault).
# Los secretos de abajo son OPCIONALES y quedan solo como respaldo del Super Admin
# (y de los avisos de sistema sin dueño). Ningún otro usuario los puede usar.

# Fuente paga (opcional). Sin esto, KODA usa solo OSM/Overpass (gratis).
GOOGLE_PLACES_API_KEY=
# Tope mensual por defecto (USD) por usuario; se puede fijar otro por usuario en el panel.
COSTO_MAX_MENSUAL_USD=50

# Discord (Fase 3) — webhooks globales por canal (respaldo del Super Admin).
DISCORD_WEBHOOK_HOT=
DISCORD_WEBHOOK_NUEVOS=
DISCORD_WEBHOOK_REPORTES=
DISCORD_WEBHOOK_ERRORES=

# URL del panel para los enlaces de las notificaciones.
KODA_PANEL_URL=https://koda.connexoapp.com
